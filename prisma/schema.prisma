// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

// Assuming you are using PostgreSQL on Vercel. 
// If you are using MySQL or SQLite, change the provider accordingly.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// AUTH.JS (NEXTAUTH) MODELS
// ==========================================

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  emailVerified DateTime?
  image         String?
  role          Role            @default(CLIENT)
  accounts      Account[]
  sessions      Session[]
  
  // Custom relations
  eventAccess   EventAccess[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  CLIENT
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ==========================================
// KORRIN'S PHOTOS APP MODELS
// ==========================================

model Event {
  id        String   @id @default(cuid())
  title     String
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos    Photo[]
  access    EventAccess[]
}

model Photo {
  id                String   @id @default(cuid())
  eventId           String
  cloudflareUrl     String
  cloudflareImageId String
  label             String?
  category          String?  // e.g., "wedding", "portrait", "editorial", "landscape"
  
  uploadedAt        DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

// Junction table mapping which Clients have access to which Events
model EventAccess {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Ensures a user can't be granted access to the same event twice
  @@unique([userId, eventId])
}

model BookingInquiry {
  id            String    @id @default(cuid())
  firstName     String
  lastName      String
  email         String
  sessionType   String
  preferredDate DateTime?
  message       String
  status        String    @default("PENDING") // PENDING, REVIEWED, BOOKED, ARCHIVED
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}